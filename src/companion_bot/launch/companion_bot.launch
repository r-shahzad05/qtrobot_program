<launch>
  <arg name="greeting" default="Hello, I am your companion bot." />
  <arg name="speak_on_start" default="true" />

  <node
    name="companion_bot"
    pkg="companion_bot"
    type="companion_bot_node.py"
    output="screen">
    <param name="greeting" value="$(arg greeting)" />
    <param name="speak_on_start" value="$(arg speak_on_start)" />
  </node>
</launch>
